# Backend base URL. Leave this UNSET for the normal setup: when the page is
# opened at http://localhost:5173 the app talks to http://localhost:4000
# directly, and on any other host (LAN IP, phone, hosted preview) it goes
# same-origin through the Vite proxy (vite.config.ts) — which is what you
# want. Only set it if the API really lives somewhere else.
# VITE_API_URL=http://localhost:4000

# Stadia Maps key (free tier at https://stadiamaps.com) — powers the "Alidade"
# basemap tiles (the only tile provider, per the OSM tile-usage policy that
# blocks direct tile.openstreetmap.org use in browser apps). Browser-exposed
# tile key, public by design.
VITE_STADIA_API_KEY=8a80468f-b8a9-4af7-b551-dab98d843d3f

# ── "Sign in with Google" via Firebase (login page) ────────────────────────
# Public Firebase web values — safe to ship (the apiKey is a project
# identifier, not a secret; security comes from Firebase Auth authorized
# domains + rules). Configured for project "new-project-6e761".
VITE_FIREBASE_API_KEY=AIzaSyAAbr1aWWglmYuwCvGMJJRq3083Ph-wGos
VITE_FIREBASE_AUTH_DOMAIN=new-project-6e761.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=new-project-6e761
VITE_FIREBASE_APP_ID=1:695935356647:web:c92b327ff8d0b69393dc42
