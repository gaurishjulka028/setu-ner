DATABASE_URL="file:./dev.db"
# Signs login tokens. KEEP IT STABLE: changing it (or re-copying this file over
# server/.env) invalidates every signed-in browser at once → "session expired".
JWT_SECRET="change-this-in-production-please"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# If prisma generate/migrate fails with a TLS error downloading its engine
# from binaries.prisma.sh (some ISPs/office networks block it), uncomment:
# PRISMA_ENGINES_MIRROR="https://binaries.prismacdn.com"

# ── Fleet simulation pacing ────────────────────────────────────────────────
# Vehicles WITHOUT a live GPS feed are simulated along their route. One real
# second = SIM_TIME_SCALE simulated seconds (20 → a 6 h corridor plays out in
# ~18 min on stage). Set to 1 for real-time pacing.
# SIM_TIME_SCALE=20
# Seeded demo trucks restart their corridor 3 min after arriving so the map
# never empties during a long demo (user-started shipments never loop).
# SIM_LOOP_SEEDED=true
# Occasionally slow a moving demo truck to "delayed" on poor/caution stretches
# so a disruption happens live during the demo. false = never.
# SIM_RANDOM_HAZARDS=true
# Device-token secret for hardware trackers (POST /api/vehicles/:id/position).
# DEVICE_TOKEN_SECRET="dev-only-insecure-device-secret"

# ── Real road geometry (Stadia Maps → public OSRM fallback) ────────────────
# At startup the server snaps every road corridor to the actual highway and
# caches the result in server/data/road-geometry.json. Needs internet ONCE;
# afterwards works offline from the cache.
#
# Providers, tried in this order per segment:
#   1. Stadia Maps Routing API — set STADIA_API_KEY below. Valhalla-based,
#      weekly OSM updates, and it's a registered service rather than a shared
#      free demo, so the upgrade to full-detail geometry reliably completes.
#      Docs: https://docs.stadiamaps.com/routing/ (Standard Routing endpoint).
#   2. Public OSRM demo server — keyless fallback for deployments without a
#      Stadia key. Shared + rate-limited, so treat it as best-effort only.
#   3. Neither reachable → the bundled schematic curves stay and the map's
#      data-source legend says so.
#
# STADIA_API_KEY is SERVER-SIDE ONLY — it is read by the Node process and is
# never sent to the browser. It is deliberately separate from the client's
# VITE_STADIA_API_KEY (which only buys basemap tiles and is public by design).
# This file is COMMITTED to the repo, so real values belong only in the
# untracked server/.env (gitignored) — never here. Get a key at
# client.stadiamaps.com → Manage Properties.
# STADIA_API_KEY=""
# Routing profile: "auto" (default, matches OSRM's driving) or "truck".
# STADIA_COSTING="auto"
# Only needed for the EU-resident endpoint or a self-hosted Valhalla:
# STADIA_ROUTING_URL="https://api.stadiamaps.com"    # or https://api-eu.stadiamaps.com
#
# OSRM_URL="https://router.project-osrm.org"
# ROAD_GEOMETRY_DISABLED="false"
# How much shape detail to keep per corridor (Douglas-Peucker tolerance in
# metres + hard cap on points). Defaults are driver-grade: 8 m / 2500 pts.
# GEOMETRY_THIN_TOLERANCE_M="8"
# GEOMETRY_MAX_POINTS="2500"

# ── WhatsApp transport switch ───────────────────────────────────────────────
# ONE active value, used by every WhatsApp send in the app (dispatch, OTP…).
# Leave it unset/empty (or "simulated") for the demo — no credentials needed;
# messages are logged to the server outbox instead of a real phone. Set it to
# "msg91" or "meta" only once you've filled in that provider's keys below.
WHATSAPP_PROVIDER=""

# ── WhatsApp (MSG91) ───────────────────────────────────────────────────────
# MSG91 requires a connected/verified WhatsApp Business number and approved
# Meta templates. The account/platform fee is currently waived for the first
# two months for newly onboarded numbers, but WhatsApp message charges still
# apply. Authentication templates are subject to Meta eligibility.
# WHATSAPP_PROVIDER="msg91"   # (set the switch above instead — kept here as a reminder of the value to use)
MSG91_AUTH_KEY=""
MSG91_INTEGRATED_NUMBER=""
MSG91_WHATSAPP_API_BASE="https://api.msg91.com/api/v5/whatsapp"
# Approved generic Utility template with one body variable ({{1}}) for alerts.
MSG91_WHATSAPP_ALERT_TEMPLATE=""
MSG91_WHATSAPP_ALERT_NAMESPACE=""
MSG91_WHATSAPP_ALERT_LANGUAGE="en"
# Approved Authentication template for OTP. The OTP is supplied as body_1;
# set MSG91_WHATSAPP_OTP_BUTTON=true when the approved template also expects
# the code in its copy-code button.
MSG91_WHATSAPP_OTP_TEMPLATE=""
MSG91_WHATSAPP_OTP_NAMESPACE=""
MSG91_WHATSAPP_OTP_LANGUAGE="en"
MSG91_WHATSAPP_OTP_BUTTON="true"
# Number that receives dispatcher/dashboard alert messages (Indian E.164 digits).
WHATSAPP_DISPATCHER_TO="919999999999"

# ── Incident-photo AI (real vision model) ─────────────────────────────────
# Leave unset → built-in pixel heuristic (offline, never claims "impassable").
# For real scene understanding (detects landslide/flood/debris and gives LOW
# scores to unrelated photos) set ONE provider. RECOMMENDED — free, no card:
#
#   VISION_PROVIDER="groq"         VISION_API_KEY="gsk_..."   # console.groq.com → API Keys
#       preset model: qwen/qwen3.6-27b (image+text). Override: VISION_MODEL="meta-llama/llama-4-maverick-17b-128e-instruct"
#
# Other options:
#   VISION_PROVIDER="openrouter"   VISION_API_KEY="sk-or-..." # preset google/gemma-4-31b-it:free
#   VISION_PROVIDER="ollama"                                  # offline; `ollama pull qwen2.5vl`
#   VISION_PROVIDER="openai"       VISION_API_KEY="sk-..."    # paid; preset gpt-4o-mini
#   VISION_PROVIDER="gemini"       VISION_API_KEY="AIza..."   # paid after trial; preset gemini-2.5-flash
# VISION_MODEL / VISION_BASE_URL override any preset (e.g. a self-hosted vLLM).
#
# Pre-selected free provider: Groq (qwen/qwen3.6-27b, image+text; the same
# key also powers the disaster situation report). Until a free key from
# https://console.groq.com → API Keys is pasted below, the app silently uses
# the offline pixel heuristic, so leaving this switched on is safe.
VISION_PROVIDER="groq"
# VISION_API_KEY="gsk_..."
# VISION_MODEL=""
# VISION_BASE_URL=""

# ── Government disaster alerts (NDMA SACHET CAP feed) ──────────────────────
# Official, public, key-less per-district alerts (IMD rain, CWC floods, SDMA
# landslides…). Polled every GOVT_ALERTS_POLL_MIN minutes whenever this
# server can reach sachet.ndma.gov.in; the Alerts page shows "LIVE feed" when
# it can and "Offline copy" (bundled sample) when it can't. Nothing to sign
# up for. The NIC host is slow — allow ~20 s for the first poll.
# GOVT_ALERTS_URL="https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml"
# GOVT_ALERTS_POLL_MIN=10
# GOVT_ALERTS_DISABLED="false"

# ── Disaster situation-report analysis (LLM) ────────────────────────────────
# GET /api/analysis/disaster fuses government alerts + weather + road
# blockages + at-risk fleet + stock gaps into one structured situation report
# (overall severity, affected districts, recommended actions).
#
# ANALYSIS_PROVIDER accepts the same names as VISION_PROVIDER (groq,
# openrouter, ollama, openai, gemini) and DEFAULTS TO VISION_PROVIDER — so
# the single free Groq key above powers both the photo analyser and this
# report. Text presets: groq → openai/gpt-oss-120b, openrouter →
# openai/gpt-oss-20b:free, ollama → llama3.1, openai → gpt-4o-mini.
# With no key — or on any network/parse/schema failure — it degrades to a
# deterministic local summary (live:false) rather than failing the request.
# ANALYSIS_PROVIDER=""              # leave empty to follow VISION_PROVIDER
# ANALYSIS_MODEL=""                 # override the text model
# ANALYSIS_BASE_URL=""              # override the endpoint (self-hosted / test mock)
# ANALYSIS_ENABLED="true"           # "false" to force the local summary only

# ── Sign-in & registration ──────────────────────────────────────────────────
# Self-service registration (POST /api/auth/register) exists for three roles:
#   citizen / operator (driver)  → any valid email + password + OTP-verified phone
#   logistics (company)          → same, but a COMPANY email is required
#                                  (gmail/yahoo/outlook/… free-mail is rejected)
# MDoNER Official accounts CANNOT self-register with a password: they sign in
# with Google through Firebase using a *.gov.in / *.nic.in address. `admin` is
# seeded only (official@…/admin@setu-ner.demo demo rows).
#
# Google/Firebase sign-in: POST /api/auth/google receives the OIDC id_token
# from the Firebase popup (setu-ner/.env VITE_FIREBASE_*). Two token flavors
# are accepted and fully verified server-side (signature + issuer + audience
# via Google's public JWKs — no service account needed):
#   • Firebase-issued ID token (user.getIdToken()) — the default the app sends
#   • Google-issued OIDC token (credentialFromResult().idToken) — fallback,
#     also verified via GOOGLE_TOKENINFO_URL when JWKS is unreachable
# FIREBASE_PROJECT_ID must match the frontend's VITE_FIREBASE_PROJECT_ID —
# Firebase tokens issued for any other project are rejected (audience check).
FIREBASE_PROJECT_ID="new-project-6e761"
#   GOOGLE_TOKENINFO_URL="https://oauth2.googleapis.com/tokeninfo"  # fallback
# Role derivation: a *.gov.in / *.nic.in e-mail signs in as "official",
# everyone else as "citizen". <role>@setu-ner.demo / demo password logins are
# kept only for the seeded demo accounts.
#
# EVERY account — all roles, both registration paths — must verify a mobile
# number with a 6-digit OTP (POST /api/auth/otp/send → /otp/verify →
# phoneToken). Delivery:
#   OTP_CHANNEL="whatsapp"        # whatsapp | sms | simulated | auto
#     whatsapp  → MSG91 WhatsApp authentication template configured above.
#     sms       → optional Twilio SMS transport if you configure its credentials.
#     simulated → no provider: code is printed in the server log and, outside
#                 NODE_ENV=production, returned to the login page as devCode.
# OTP_DEV_ECHO="true"         # "false" to never return devCode even in dev
# OTP_SECRET=""               # HMAC/JWT secret for codes; defaults to JWT_SECRET

# Meta WhatsApp Cloud API
# WHATSAPP_PROVIDER="meta"   # (set the switch above instead — kept here as a reminder of the value to use)
META_WA_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
META_WA_API_VERSION="v25.0"
META_WA_VERIFY_TOKEN="setu-ner-verify"
META_WA_OTP_TEMPLATE_NAME=""
META_WA_OTP_TEMPLATE_LANGUAGE="en_US"
META_WA_UTILITY_TEMPLATE_NAME=""
META_WA_UTILITY_TEMPLATE_LANGUAGE="en_US"
